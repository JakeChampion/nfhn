{
  "name": "NFHN - Hacker News",
  "short_name": "NFHN",
  "description": "A fast, accessible Hacker News reader built with Netlify Edge Functions",
  "start_url": "/top/1",
  "display": "standalone",
  "background_color": "#f5f5f5",
  "theme_color": "#f5f5f5",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "categories": ["news", "social"],
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "shortcuts": [
    {
      "name": "Top Stories",
      "short_name": "Top",
      "description": "View top stories on Hacker News",
      "url": "/top/1",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "New Stories",
      "short_name": "New",
      "description": "View newest stories on Hacker News",
      "url": "/newest/1",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Ask HN",
      "short_name": "Ask",
      "description": "View Ask HN posts",
      "url": "/ask/1",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Show HN",
      "short_name": "Show",
      "description": "View Show HN posts",
      "url": "/show/1",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Jobs",
      "short_name": "Jobs",
      "description": "View job postings",
      "url": "/jobs/1",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Saved Stories",
      "short_name": "Saved",
      "description": "View your saved stories",
      "url": "/saved",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+hn",
      "url": "/item/%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/saved",
      "accept": {
        "application/json": [".json"]
      }
    }
  ]
}
