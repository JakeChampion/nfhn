{
  "name": "hn",
  "version": "1.0.0",
  "description": "You can view the deployed version at <https://hn.jakechampion.name/>",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakeChampion/nfhn.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/JakeChampion/nfhn/issues"
  },
  "homepage": "https://github.com/JakeChampion/nfhn#readme",
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@netlify/blobs": "^10.7.12",
    "@netlify/edge-functions": "^3.0.2",
    "@netlify/functions": "^5.3.0"
  },
  "devDependencies": {
    "husky": "^9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "deno fmt"
  },
  "scripts": {
    "dev": "netlify dev",
    "build": "deno run --allow-read --allow-write --allow-env scripts/build.ts",
    "test": "deno test --allow-net --allow-env --allow-read tests/",
    "test:watch": "deno test --allow-net --allow-env --allow-read --watch tests/",
    "test:coverage": "deno test --allow-net --allow-env --allow-read --coverage=coverage tests/ && deno coverage coverage",
    "lint": "deno lint netlify/edge-functions tests",
    "fmt": "deno fmt netlify/edge-functions tests",
    "prepare": "husky"
  }
}
