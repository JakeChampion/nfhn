{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true
  },
  "tasks": {
    "dev": "netlify dev",
    "build": "deno run --allow-read --allow-write --allow-env scripts/build.ts"
  },
  "lint": {
    "exclude": [
      "netlify/edge-functions/lib/readability.js",
      "netlify/edge-functions/lib/vendor/",
      "static/"
    ],
    "rules": {
      "include": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "exclude": [
      "netlify/edge-functions/lib/vendor/"
    ]
  }
}
